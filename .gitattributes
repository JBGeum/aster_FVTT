# Normalize line endings in the repository (LF in repo, native on checkout)
* text=auto

# Force LF for these regardless of OS
*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.mts   text eol=lf
*.json  text eol=lf
*.scss  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.gif   binary
*.webp  binary
*.woff  binary
*.woff2 binary
